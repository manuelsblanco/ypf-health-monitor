{
  "name": "ypf-health-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "monitor": "node src/run.js",
    "build": "node src/build.js",
    "test": "node --test tests/*.test.js",
    "check:health": "node src/gate.js",
    "preview": "node src/serve.js",
    "test:browser": "node --test tests/browser.integration.js",
    "monitor:dfs": "CRAWL_STRATEGY=dfs node src/run.js",
    "test:dashboard": "node --test tests/dashboard.integration.js"
  },
  "dependencies": {
    "playwright": "1.58.2"
  }
}
